{
  "name": "microsoft-agentic-guidance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server-production.js",
  "description": "Decision and planning guidance tool to determine which Microsoft agentic platform—Microsoft 365 Copilot, Copilot Studio, or Microsoft Foundry—fits each specific use case",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:ports && node scripts/dev-orchestrator.mjs",
    "dev:ports": "node scripts/free-dev-ports.mjs",
    "dev:parallel": "concurrently -k -s first -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:gated": "npm run dev:ports && concurrently -k -s first -n api,web \"npm run dev:api\" \"wait-on --timeout 240000 http://localhost:3001/api/health && npm run dev:web\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build:packages && npm run build:api",
    "build:packages": "npm run build --workspace=packages/decision-engine",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "start": "node apps/api/dist/index.js",
    "start:dev": "node server.js",
    "test": "npm run test --workspaces --if-present",
    "test:prod": "node scripts/test-production.js",
    "validate": "ts-node scripts/validate-microsoft-updates.ts",
    "validate:watch": "nodemon --watch scripts --exec npm run validate",
    "validate:licensing": "ts-node scripts/validate-licensing-guide.ts",
    "validate:survey": "ts-node scripts/validate-survey-questions.ts",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "concurrently": "^9.1.2",
    "eslint": "^10.0.0",
    "node": "^25.6.1",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.0.2",
    "prettier": "^3.4.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.5"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "ajv": "^8.18.0"
  }
}
