# Azure Deployment Ignore

# Only exclude what's truly not needed for production

# Development dependencies can be installed during build

# DO NOT exclude node_modules - let Azure handle this

# Documentation (optional - can exclude to reduce deployment size)

docs/
\*.md
!README.md

# Development files

.vscode/
.idea/
_.swp
_.swo

# Test files

**/\*.test.js
**/_.test.ts
\*\*/_.spec.js \*_/_.spec.ts
coverage/

# Source files (compiled versions in dist/ will be used)

# NOTE: We keep TypeScript source for reference/debugging

# but could exclude if deployment size is a concern

# Local env

.env.local
.env.development.local
.env.test.local

# Git

.git/
.gitignore

# Build artifacts that aren't needed

\*.tsbuildinfo
.DS_Store
Thumbs.db

# IMPORTANT: Do NOT exclude these:

# - server-production.js (main entry point)

# - packages/\*/dist/ (compiled TypeScript)

# - apps/web/dist/ (built frontend)

# - package.json, package-lock.json (dependency management)

# - node_modules/ (let Azure handle this)
